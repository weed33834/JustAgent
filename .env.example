# JustAgent API 凭证示例（复制为 .env 后填入真实值）
# 测试用凭证
MYAGENT_TEST_API_KEY=your-api-key-here
MYAGENT_TEST_API_BASE=https://api.hcnsec.cn

# LLM 提供商凭证（在 .justagent.toml 中通过 ${VAR} 引用）
OPENAI_API_KEY=sk-your-openai-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key
AZURE_OPENAI_API_KEY=your-azure-key

# JustAgent Web（`justagent web`）
# 设置后 Web 的 /api/* 需携带 Authorization: Bearer <JUSTAGENT_WEB_TOKEN> 才能访问
JUSTAGENT_WEB_TOKEN=
# Web 服务监听地址（docker 中通常为 0.0.0.0）
JUSTAGENT_WEB_HOST=127.0.0.1
JUSTAGENT_WEB_PORT=8000
# Web 通知 webhook（可选，收到事件时 POST 该地址）
JUSTAGENT_WEBHOOK_URL=
# Web 默认管理员密码（未设置则自动生成并打印一次）
JUSTAGENT_WEB_ADMIN_PASSWORD=
