# AutoShip example configuration
# Copy this to autoship.toml in your project root and adjust as needed

[clean]
enabled = true
tools = ["ruff"]
exclude = ["migrations", ".venv", "__pycache__"]

[verify]
enabled = true
command = "pytest tests/ -v"

[commit]
enabled = true
conventional_commits = true
auto_stage = true
max_diff_lines = 3000

[upload]
enabled = false
# target = "pypi"  # pypi | docker | custom

[security]
enabled = true
tools = ["semgrep"]
threshold = "medium"

[hooks]
enabled = false

[[hooks.on_save]]
command = "clean"
include = ["src/**/*.py"]
debounce_ms = 300

# Model configuration — configure one or more backends
[model]
default_tier = 1

[[model.backends]]
provider = "openai"
base_url = "https://api.openai.com/v1"
api_key = "${OPENAI_API_KEY}"
model = "gpt-4o-mini"

